<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/index.css" type="text/css">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css"/>
        <link rel="stylesheet" href="/swiper.css">
        <title>Meera</title>
    </head>
    <body>
        <header>
            <nav>
                <h1>मीरा</h1>
                <div id="nav-btns">
                    <a href="/shop">Shop</a>
                    <a href="#contact">Contact</a>
                </div>
            </nav>

            <section>
                <div class="swiper swiper-1">
                <div class="swiper-wrapper">
                    <div class="swiper-slide">
                        <img class="swiper-img" src="/Images/Vignaharta.png" alt="">
                        <span>The remover of obstacles</span>
                    </div>

                    <div class="swiper-slide">
                        <img class="swiper-img" src="/Images/Brutalism.png" alt="">
                        <span>Made according to surroundings</span>
                    </div>

                    <div class="swiper-slide">
                        <img class="swiper-img" src="/Images/Buddha.png" alt="">
                        <span>Bring home the serenity of Buddha</span>
                    </div>

                    <div class="swiper-slide">
                        <img class="swiper-img" src="/Images/Ragini.jpg" alt="">
                        <span>Bringing Miniatures back in fashion</span>
                    </div>

                    <div class="swiper-slide">
                        <img class="swiper-img" src="/Images/tagore sketch.jpg" alt="">
                        <span>On-demand portraits</span>
                    </div>

                    <div class="swiper-slide">
                        <img class="swiper-img" src="/Images/discussion.png" alt="">
                        <span>Give your friends something to talk about.</span>
                    </div>

                </div>
                <div class="swiper-pagination swiper-pagination-1"></div>
                <div class="swiper-button-prev swiper-button-prev-1"></div>
                <div class="swiper-button-next swiper-button-next-1"></div>
                <div class="swiper-scrollbar"></div>
            </div>
            </section>
            

            <section>
                <div id="why-buy-here">
                <h2>Why buy here?</h2>
                <div id="features">
                    <div>
                        <img src="/Images/LisaBoy.png" class=" features-img" loading="lazy" alt="Art studio authenticity">
                        <span>All products are authentic and directly from the studio</span>
                    </div>

                    <div>
                        <img src="/Images/krisnaMeera.png" class=" features-img" loading="lazy" alt="Art for your space">
                        <span>Art that complements your space</span>
                    </div>

                    <div>
                        <img src="/Images/Community.png" class=" features-img" loading="lazy" alt="Kalagoshti community">
                        <span>Community connection. Join Kalagoshti - a community of art lovers</span>
                    </div>
                </div>
            </div>
            </section>

            <section>
                <div class="swiper swiper-2">
                <div class="swiper-wrapper">
                    <div class="swiper-slide"><img src="/Images/Vignaharta.png" alt="painting" loading="lazy"></div>
                    <div class="swiper-slide"><img src="/Images/Sangeet Sabha.jpeg" alt="painting" loading="lazy"></div>
                    <div class="swiper-slide"><img src="/Images/K.jpeg" alt="painting" loading="lazy"></div>
                    <div class="swiper-slide"><img src="/Images/Colorful Buddha Silhouette Design.jpg" alt="painting" loading="lazy"></div>
                    <div class="swiper-slide"><img src="/Images/danny-lines-FQ9AMbgcUTU-unsplash.jpg" alt="painting" loading="lazy"></div>
                    <div class="swiper-slide"><img src="/Images/elina-mellov-69nfar-HqU0-unsplash.jpg" alt="painting" loading="lazy"></div>
                    <div class="swiper-slide"><img src="/Images/nick-sokolov-JJwJh00cqSY-unsplash.jpg" alt="painting"></div>
                    <div class="swiper-slide"><img src="/Images/WhatsApp Image 2026-01-09 at 2.18.53 PM.jpeg" alt="painting"></div>
                </div>
                <div class="swiper-pagination swiper-pagination-2"></div>
                <div class="swiper-button-prev swiper-button-prev-2"></div>
                <div class="swiper-button-next swiper-button-next-2"></div>
                <div class="swiper-scrollbar"></div>
                </div>
            </section>
            
        </header>

        <footer id="contact">
            <section id="google-signin-section" aria-labelledby="google-signin-heading">
                <div class="google-signin-copy">
                    <h2 id="google-signin-heading">Sign in with Google</h2>
                    <p>Save your preferences and make future sign-in smoother once Google auth is enabled.</p>
                </div>

                <div class="google-signin-card">
                    <div id="g_id_onload"
                        data-client_id="239359877649-pg20l8dhh186b6va3mpihrhpc4sshrrc.apps.googleusercontent.com"
                        data-context="signup"
                        data-ux_mode="popup"
                        data-login_uri="http://localhost:8080/auth/google"
                        data-nonce=""
                        data-itp_support="true">
                    </div>

                    <div class="g_id_signin"
                        data-type="standard"
                        data-shape="rectangular"
                        data-theme="outline"
                        data-text="signin_with"
                        data-size="large"
                        data-logo_alignment="left">
                    </div>
                    <div id="google-user-card" class="google-user-card" hidden>
                        <img id="google-user-picture" class="google-user-picture" alt="Signed in user avatar">
                        <div class="google-user-copy">
                            <p id="google-user-name" class="google-user-name"></p>
                            <p id="google-user-email" class="google-user-email"></p>
                        </div>
                        <button id="google-logout-button" class="google-logout-button" type="button">Log out</button>
                    </div>
                    <p id="google-signin-hint" class="google-signin-hint">This uses Google's HTML setup. Server-side verification is still the next step.</p>
                </div>
            </section>

            <form id="email-sub-container">
                <h2>Subscribe to our Newsletter</h2>
                <input type="email" id="email-el">
                <p id="sub-message">Get notified about upcoming workshops, new products and sales!</p>
            </form>

            <p>© 2026 Meera. All rights reserved.</p>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"></script>
        <script src="/index.js"></script>
        <script src="/handleSwiper.js"></script>
        <script src="https://accounts.google.com/gsi/client" async></script>
    </body>
</html>
